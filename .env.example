# Supabase — reuse Upthink Platform project (optional; without these → local demo)
NEXT_PUBLIC_SUPABASE_URL=https://jwjezdgggrgdgfsovgtx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Owner PIN — required to delete sheets / restore snapshots (shared book)
UPSIDE_OWNER_PIN=123789

# Vercel Cron auth for /api/cron/snapshot (set the same value in Vercel → Cron)
CRON_SECRET=change-me-to-a-long-random-string

# Assistant Margus — OpenRouter (OpenAI-compatible)
# Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_key_here
MODEL=nvidia/nemotron-3-super-120b-a12b:free
MODEL_VISION=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# Max IQ (slow): MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Fast/light: MODEL=nvidia/nemotron-3-nano-30b-a3b:free
# MODEL=openai/gpt-oss-20b:free

# Optional Groq fallback (also OpenAI-compatible)
# GROQ_API_KEY=your_key_here
# GROQ_MODEL=llama-3.3-70b-versatile
