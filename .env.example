# Supabase — dedicated Upside Lab project (without these → local demo)
# Client (browser) must use the NEXT_PUBLIC_ names. Server also accepts
# SUPABASE_URL / SUPABASE_ANON_KEY as aliases for the same values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# Prefer service role for API writes + seed claims (bypasses RLS intentionally)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Direct Postgres URI if you run dumps / psql against the dedicated instance
# DATABASE_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres

# Optional seed emails for Karud / Lap Google accounts (Martin is in DB seed_claims)
# UPSIDE_SEED_KARUD_EMAIL=karud@example.com
# UPSIDE_SEED_LAP_EMAIL=lap@example.com

# Vercel Cron auth for /api/cron/snapshot (set the same value in Vercel → Cron)
CRON_SECRET=change-me-to-a-long-random-string

# Canonical host. Default is upsidelab.app. Legacy Vercel aliases 301 here.
UPSIDE_CANONICAL_HOST=upsidelab.app
NEXT_PUBLIC_SITE_URL=https://upsidelab.app

# Market data — Yahoo (yahoo-finance2, no key) is primary and free. These are
# OPTIONAL extra free-tier fallbacks used only for tickers Yahoo couldn't
# price; the app works fine with none of them set.
# Twelve Data: 800 credits/day free, no card — https://twelvedata.com/pricing
# TWELVE_DATA_API_KEY=your_key_here
# Finnhub: 60 calls/min free, no card — https://finnhub.io/register
# FINNHUB_API_KEY=your_key_here

# Assistant Margus — OpenRouter (OpenAI-compatible)
# Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_key_here
MODEL=nvidia/nemotron-3-super-120b-a12b:free
MODEL_VISION=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# Comma-separated OpenRouter fallbacks when primary is rate-limited
# MODEL_FALLBACKS=nvidia/nemotron-3-nano-30b-a3b:free,openai/gpt-oss-20b:free
# Max IQ (slow): MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Fast/light: MODEL=nvidia/nemotron-3-nano-30b-a3b:free
# MODEL=openai/gpt-oss-20b:free

# Optional forecast-only model override (falls back to MODEL)
# MODEL_FORECAST=nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_MODEL=...
# OPENROUTER_VISION_MODEL=...
# OPENROUTER_HTTP_REFERER=https://upsidelab.app
# OPENROUTER_APP_TITLE=Upside Lab Assistant Margus

# Optional Groq fallback (also OpenAI-compatible, free tier, no card).
# openai/gpt-oss-120b specifically -- Groq's structured-output guarantee
# (needed by forecast/thesis-pulse/margus-fund) is limited to the gpt-oss
# family; other Groq models 400 on any generateObject call.
# Get a key: https://console.groq.com/keys
# GROQ_API_KEY=your_key_here
# GROQ_MODEL=openai/gpt-oss-120b

# Optional Gemini fallback (free tier, no card, natively multimodal so it
# also covers vision/screenshot-import requests). Use the rolling "-latest"
# alias, not a dated snapshot -- Google retires dated model IDs over time.
# Get a key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_key_here
# GEMINI_MODEL=gemini-flash-latest

# Cerebras was evaluated and deliberately skipped: despite "start building
# for free" marketing, every model requires a verified payment method
# before any inference call works at all (a $5, 30-day trial credit is
# granted only after a card is added) -- not the no-card free tier the
# other providers above genuinely are. Not worth it as a 4th fallback tier
# behind three providers that already work without a card.

# Margus tries every configured provider above in order (OpenRouter -> Groq
# -> Gemini) before giving up, so one provider running out of free-tier
# quota doesn't take the assistant down if you've set up more than one.
# None of these are required — the app works with just OPENROUTER_API_KEY,
# same as before.
